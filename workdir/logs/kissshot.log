        );

        let keyboard = InlineKeyboardMarkup::new(vec![vec![
            InlineKeyboardButton::callback("🔄 Generate Again", 
                format!("gen_again:{}:{}:{}:{}:{}", raw_bin, raw_month, raw_year, raw_cvv, amount_value))
